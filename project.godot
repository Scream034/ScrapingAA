config/version="0.95"
config/tags=PackedStringArray("my")
run/main_scene="uid://dvgfsp6aptj78"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
run/delta_smoothing=false
boot_splash/bg_color=Color(0.185188, 0.161358, 0.210583, 1)
boot_splash/show_image=false
